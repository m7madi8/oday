# Resend (Transactional Email) — https://resend.com
# Add domain od-architects.com in Resend and verify DNS (SPF/DKIM) before sending.
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=contact@od-architects.com
RESEND_FROM_NAME=OD ARCHITECTS

# Where form submissions are delivered
CONTACT_EMAIL=abodohaoday@gmail.com

# Optional — build-time hero tooling (`npm run hero:expand` only; not used by the live site)
IMAGE_AI_PROVIDER=openai
IMAGE_AI_API_KEY=
